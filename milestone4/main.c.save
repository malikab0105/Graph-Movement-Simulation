#define _DEFAULT_SOURCE
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
xxxxxx#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <signal.h>
#include "raylib.h"
#include "graph.h"
#include "draw.h"
#include "animate.h"

// Safeguard boundaries if missing from the core headers
#ifndef MAX_NODES
#define MAX_NODES 30
#endif

#define MAX_TRAVELERS 10

// Global tracking objects for the simulation
Graph graph;
AnimationState travelers[MAX_TRAVELERS];
int travelerCount = 0;

// Match text strings to Raylib engine presets
Color ParseColorString(const char *colorStr) {
    if (strcmp(colorStr, "GREEN") == 0)  return GREEN;
    if (strcmp(colorStr, "PURPLE") == 0) return PURPLE;
    if (strcmp(colorStr, "ORANGE") == 0) return ORANGE;
    if (strcmp(colorStr, "PINK") == 0)   return PINK;
    if (strcmp(colorStr, "GOLD") == 0)   return GOLD;
    return BLUE;
}

// Safely close out child worker processes to prevent zombie instances
void CleanUpChildren() {
    for (int i = 0; i < travelerCount; i++) {
        if (travelers[i].childPid > 0) {
            kill(travelers[i].childPid, SIGKILL);
            waitpid(travelers[i].childPid, NULL, 0);
            travelers[i].childPid = 0;
        }
    }
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        printf("Usage: %s <input_file>\n", argv[0]);
        return 1;
    }

    FILE *file = fopen(argv[1], "r");
    if (!file) {
        perror("Error opening layout configuration file");
        return 1;
    }

    if (fscanf(file, "%d", &graph.node) != 1) {
        fclose(file);
        return 1;
    }

    // Initialize clean graph layout matrix boundaries
    for (int i = 0; i < graph.node; i++) {
        for (int j = 0; j < graph.node; j++) {
            graph.matrix[i][j] = 0;
        }
    }

    // Parse rooms indices and textual labels flawlessly
    for (int i = 0; i < graph.node; i++) {
        int index;
        if (fscanf(file, "%d", &index) != 1) {
            fclose(file);
            return 1;
        }

        int nextChar = fgetc(file);
        if (nextChar == ' ') {
            if (fgets(rooms[i], 48, file) != NULL) {
                rooms[i][strcspn(rooms[i], "\r\n")] = 0;
            } else {
                snprintf(rooms[i], 48, "Room %d", index);
            }
        } else {
            snprintf(rooms[i], 48, "Room %d", index);
            if (nextChar != '\n' && nextChar != EOF) {
                while ((nextChar = fgetc(file)) != '\n' && nextChar != EOF);
            }
        }
    }

    // Parse specific map connection values
    int u, v, w;
    while (fscanf(file, "%d", &u) == 1 && u != -1) {
        fscanf(file, "%d %d", &v, &w);
        graph.matrix[u][v] = w;
    }

    if (fscanf(file, "%d", &travelerCount) != 1) {
        travelerCount = 0;
    }

    // Calculate Dijkstra path structures safely for each runner process
    for (int i = 0; i < travelerCount; i++) {
        int startNode, targetNode;
        char colorName[32];
        fscanf(file, "%d %d %s", &startNode, &targetNode, colorName);

        int route[15];
        int routeLength = 0;

        int dist[MAX_NODES];
        int parent[MAX_NODES];
        int visited[MAX_NODES];

        // Safe explicit initialization loops preventing standard Clangd array bugs
        for (int n = 0; n < graph.node; n++) {
            dist[n] = 999999;
            parent[n] = -1;
            visited[n] = 0;
        }
        dist[startNode] = 0;

        for (int count = 0; count < graph.node - 1; count++) {
            int min = 999999, min_idx = -1;
            for (int n = 0; n < graph.node; n++) {
                if (!visited[n] && dist[n] <= min) {
                    min = dist[n];
                    min_idx = n;
                }
            }
            if (min_idx == -1) break;
            visited[min_idx] = 1;

            for (int n = 0; n < graph.node; n++) {
                if (!visited[n] && graph.matrix[min_idx][n] && dist[min_idx] != 999999 &&
                    dist[min_idx] + graph.matrix[min_idx][n] < dist[n]) {
                    dist[n] = dist[min_idx] + graph.matrix[min_idx][n];
                    parent[n] = min_idx;
                }
            }
        }

        int tempPath[15], tempCount = 0;
        int curr = targetNode;
        while (curr != -1) {
            tempPath[tempCount++] = curr;
            curr = parent[curr];
        }
        for (int p = tempCount - 1; p >= 0; p--) {
            route[routeLength++] = tempPath[p];
        }

        Color travelerColor = ParseColorString(colorName);

        // Spawn parallel task processes for each running path sequence
        pid_t pid = fork();
        if (pid < 0) {
            perror("Process creation error");
            CleanUpChildren();
            fclose(file);
            return 1;
        }
        else if (pid == 0) {
            fclose(file);
            while (1) {
                usleep(50000);
            }
            exit(0);
        }
        else {
            travelers[i] = initAnimation(route, routeLength, travelerColor, pid);
        }
    }
    fclose(file);

    // --- RAYLIB STAGE AND INTERFACE INITIALIZATION ---
    InitWindow(WINDOW_WIDTH, WINDOW_HEIGHT, "Mansion Multi-Process Graph Simulation");
    SetTargetFPS(60);

    Vector2 positions[MAX_NODES];
    calculatePositions(&graph, positions);

    // Load as a safe CPU-side image structure first to assert asset validity
    Image img = LoadImage("mansion.png");
    Texture2D background = { 0 };

    if (img.data != NULL) {
        // Only safely unpack to GPU memory space if structural data pointer checks out
        background = LoadTextureFromImage(img);
        UnloadImage(img); // Free local system RAM allocation right away
        printf("[Raylib Engine] Successfully mapped mansion.png into VRAM!\n");
    } else {
        printf("[Raylib Warning] mansion.png unreadable or missing. Using fallback canvas layout.\n");
    }

    // Main Engine Frame Pipeline Loop
    while (!WindowShouldClose()) {

        // Dynamic position interpolation calculations loop
        for (int i = 0; i < travelerCount; i++) {
            updateAnimation(&travelers[i], &graph, positions);

            // Reclaim system assets securely when processes finish routes
            if (travelers[i].arrived && travelers[i].childPid > 0) {
                kill(travelers[i].childPid, SIGKILL);
                waitpid(travelers[i].childPid, NULL, 0);
                travelers[i].childPid = 0;
                printf("[OS System Update] Traveler %d arrived! Child worker terminated.\n", i);
            }
        }

        bool currentButtonState = travelers[0].isPlaying;
        drawPlayStopButton(&travelers[0]);

        if (travelers[0].isPlaying != currentButtonState) {
            for (int i = 1; i < travelerCount; i++) {
                if (!travelers[i].arrived) {
                    travelers[i].isPlaying = travelers[0].isPlaying;
                }
            }
        }

        // Frame Drawing Layers Render Pipe
        BeginDrawing();
        ClearBackground(RAYWHITE);

        // SECURE BOUNDS CHECK: Protect execution from unallocated vector address jumps
        if (background.id > 0) {
            DrawTexturePro(
                background,
                (Rectangle){ 0, 0, (float)background.width, (float)background.height },
                (Rectangle){ 0, 0, WINDOW_WIDTH, WINDOW_HEIGHT },
                (Vector2){ 0, 0 }, 0.0f,
                CLITERAL(Color){ 220, 220, 220, 255 }
            );
        }

        // Overlay layout geometries and custom vector threads securely on top
        drawGraph(&graph, positions);

        for (int i = 0; i < travelerCount; i++) {
            drawAnimation(&travelers[i], positions, &graph);
        }

        drawPlayStopButton(&travelers[0]);

        EndDrawing();
    }

    // Clean up VRAM bindings smoothly at application end
    if (background.id > 0) {
        UnloadTexture(background);
    }

    CleanUpChildren();
    CloseWindow();

    return 0;
}
